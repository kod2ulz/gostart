# ============================================================
# APPLICATION CONFIGURATION
# ============================================================

# Application name
APP_NAME=user-service

# Application version
APP_VERSION=1.0.0

# Server configuration (new format - takes precedence)
SERVER_HTTP_PORT=8080
SERVER_HTTP_ADDRESS=0.0.0.0

# Server configuration (old format - for backward compatibility)
# APP_HTTP_PORT=8080
# APP_HTTP_ADDRESS=0.0.0.0

# Time location
APP_TIME_LOCATION=Africa/Kampala

# ============================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================

# Database driver
POSTGRES_DB_DRIVER=postgres

# Database connection
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_USERNAME=postgres
POSTGRES_DB_PASSWORD=postgres
POSTGRES_DB_DATABASE=user_service

# SSL mode (disable, require, verify-ca, verify-full)
POSTGRES_DB_SSL_MODE=disable

# Heartbeat configuration
POSTGRES_DB_HEARTBEAT_MILLISECONDS=5000
POSTGRES_DB_HEARTBEAT_TIMEOUT_MILLISECONDS=20000

# ============================================================
# LOGGING CONFIGURATION
# ============================================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable API request logging (true/false)
logapi=true

# ============================================================
# OPENAPI/SWAGGER CONFIGURATION
# ============================================================

# API Documentation
API_TITLE=User Service API
API_DESCRIPTION=RESTful API for managing users
API_VERSION=1.0.0

# ============================================================
# RABBITMQ CONFIGURATION (optional)
# ============================================================

# MQ_HOST=localhost
# MQ_PORT=5672
# MQ_USERNAME=guest
# MQ_PASSWORD=guest
# MQ_VHOST=/

# ============================================================
# CONSUL CONFIGURATION (optional)
# ============================================================

# CONSUL_HOST=localhost
# CONSUL_PORT=8500
# CONSUL_TOKEN=
# CONSUL_SERVICE_NAME=user-service

# ============================================================
# VAULT CONFIGURATION (optional)
# ============================================================

# VAULT_ADDR=http://localhost:8200
# VAULT_TOKEN=
# VAULT_PATH=secret/user-service
